generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id(map: "User_pkey") @default(uuid())
  email        String   @unique(map: "User_email_key")
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// =====================================
// PRODUCT HIERARCHY
// Category → Flavor → Size → Batch
// =====================================

// Base product category (e.g., Apple Butter, Applesauce, Jams, Pickles)
model ProductCategory {
  id          String          @id @default(uuid())
  name        String          @unique  // "Apple Butter", "Applesauce", "Jams", "Pickles"
  description String?                  // General description for the category
  imageUrl    String?                  // Default image for category
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  flavors     ProductFlavor[]

  @@map("product_categories")
}

// Flavor/variant of a base product (e.g., Caramel Thyme, Maple Cinnamon, Classic)
model ProductFlavor {
  id            String           @id @default(uuid())
  categoryId    String
  name          String           // "Caramel Thyme", "Classic", "Maple Cinnamon"
  description   String?          // Specific description for this flavor
  imageUrl      String?          // Override image for this flavor
  isAvailable   Boolean          @default(true)  // Admin visibility toggle
  sortOrder     Int              @default(0)
  cogsRecipeId  String?          @unique
  costUpdatedAt DateTime?        // When recipe costs were last updated (for Shop alert)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cogsRecipe    CogsRecipe?      @relation(fields: [cogsRecipeId], references: [id])
  sizes         ProductSize[]
  batches       ProductBatch[]
  orderItems    OrderItem[]

  @@unique([categoryId, name])  // No duplicate flavors within a category
  @@index([categoryId])
  @@index([isAvailable])
  @@map("product_flavors")
}

// Size options for a flavor (e.g., 8oz, 16oz, 32oz)
model ProductSize {
  id            String         @id @default(uuid())
  flavorId      String
  sizeKey       String         // "small-8oz", "regular-16oz", "quart-32oz"
  sizeLabel     String         // "Small Jar (8 oz)", "Regular Jar (16 oz)"
  sizeOz        Int            // 8, 16, 32 - for sorting
  unitPrice     Int            // Retail price in cents
  labelCost     Int            @default(15)  // Label cost in cents (default $0.15)
  containerCost Int            @default(100) // Container cost in cents (default $1.00)
  quantity      Int            @default(0)  // Current stock count
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  flavor        ProductFlavor  @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  batches       ProductBatch[]

  @@unique([flavorId, sizeKey])  // One size option per flavor
  @@index([flavorId])
  @@index([quantity])
  @@index([sizeOz])
  @@map("product_sizes")
}

// Production batch tracking
model ProductBatch {
  id          String        @id @default(uuid())
  flavorId    String
  sizeId      String?       // Optional: link to specific size if batch is size-specific
  batchDate   DateTime      @default(now())  // When this batch was made
  quantity    Int           // Number of units produced
  notes       String?       // Optional notes about this batch
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  flavor      ProductFlavor @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  size        ProductSize?  @relation(fields: [sizeId], references: [id])

  @@index([batchDate])
  @@index([flavorId])
  @@map("product_batches")
}

// =====================================
// LEGACY: Keeping for migration (can remove after full migration)
// =====================================

model Product {
  id           String           @id(map: "Product_pkey") @default(uuid())
  name         String
  description  String
  price        Int              @default(0)
  imageUrl     String           @default("")
  isAvailable  Boolean          @default(true)
  quantity     Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     String?
  cogsRecipeId String?          @unique
  orderItems   OrderItem[]      @relation("LegacyOrderItems")
  variants     ProductVariant[]
  cogsRecipe   CogsRecipe?      @relation("LegacyCogsRecipe", fields: [cogsRecipeId], references: [id])

  @@index([category])
  @@index([quantity])
  @@map("products")
}

// Legacy variant model (keeping for migration)
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  sku        String?
  sizeKey    String
  sizeLabel  String
  sizeOz     Int
  unitPrice  Int
  quantity   Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sizeKey])
  @@index([productId])
  @@index([quantity])
  @@index([sizeOz])
  @@map("product_variants")
}

model Order {
  id                    String            @id @default(uuid())
  customerName          String
  customerEmail         String
  customerPhone         String
  shippingAddress       Json?
  fulfillmentMethod     FulfillmentMethod
  shippingCost          Int?
  subtotal              Int
  total                 Int
  paymentStatus         PaymentStatus     @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  proceedsChoice        String?
  seedCount             Int?
  extraSupportAmount    Int?
  items                 OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  // New hierarchy references
  flavorId    String?        // Reference to ProductFlavor
  sizeKey     String?        // Size key for the ordered item
  // Legacy fields (kept for migration and backwards compatibility)
  productId   String?        // Legacy: reference to old Product model
  productName String         // Snapshot of full product name at time of order
  variantKey  String?        // Legacy: Size variant key
  // Order details
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  // Relations
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  flavor      ProductFlavor? @relation(fields: [flavorId], references: [id])
  product     Product?       @relation("LegacyOrderItems", fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([flavorId])
  @@map("order_items")
}

model Ingredient {
  id                String                 @id @default(uuid())
  name              String
  unitCost          Float                  // Cost per recipe unit (auto-calculated or manual)
  unit              String                 // Recipe unit (tbsp, cup, oz, each, etc.)
  source            IngredientSource       @default(PANTRY)
  category          String?
  notes             String?
  // Purchase tracking (what you buy at the store)
  purchaseSize      Float?                 // e.g., 2 for "2 lb bag"
  purchaseUnit      String?                // e.g., "lb", "bag", "oz"
  purchaseCost      Float?                 // Total cost of purchase, e.g., $4.00
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  recipeIngredients CogsRecipeIngredient[]
  crops             Crop[]

  @@index([name])
  @@index([category])
  @@index([source])
  @@map("ingredients")
}

model CogsRecipe {
  id            String                 @id @default(uuid())
  name          String
  description   String?
  containerType String
  containerCost Float                  @default(0)
  labelCost     Float                  @default(0.20)
  energyCost    Float                  @default(0.30)
  retailPrice   Float
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  status        RecipeStatus           @default(IDEA)
  batchYield    Int?                   // Number of jars this batch makes (null = per-jar mode)
  ingredients   CogsRecipeIngredient[]
  // New hierarchy relation
  flavor        ProductFlavor?
  // Legacy relation (kept for migration)
  product       Product?               @relation("LegacyCogsRecipe")

  @@index([status])
  @@map("cogs_recipes")
}

model CogsRecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Float
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recipe       CogsRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@map("cogs_recipe_ingredients")
}

model Crop {
  id                String      @id @default(uuid())
  name              String
  type              CropType    @default(ANNUAL)
  seedStartWeek     Int?
  seedStartNotes    String?
  plantOutWeekStart Int?
  plantOutWeekEnd   Int?
  directSow         Boolean     @default(false)
  harvestStart      Int
  harvestEnd        Int
  peakStart         Int?
  peakEnd           Int?
  color             String      @default("#4A7C59")
  notes             String?
  ingredientId      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  // Yield tracking
  plantCount        Int         @default(0)
  yieldPerUnit      Decimal?    @db.Decimal(10, 2)
  yieldUnit         String      @default("lbs") @db.VarChar(50)
  lastYearYield     Decimal?    @db.Decimal(10, 2)
  // Spacing for Layout Sandbox
  spacingInches     Int?        @default(12)
  ingredient        Ingredient? @relation(fields: [ingredientId], references: [id])

  @@index([harvestStart])
  @@map("crops")
}

model SeasonalTask {
  id          String    @id @default(uuid())
  title       String
  month       Int
  weekOfMonth Int?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  year        Int
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([year, month])
  @@index([isCompleted])
  @@map("seasonal_tasks")
}

model GardenLayout {
  id          String   @id @default(uuid())
  name        String
  canvasData  Json     @default("{\"beds\": [], \"plants\": []}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("garden_layouts")
}

enum FulfillmentMethod {
  SHIPPING
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum FulfillmentStatus {
  PENDING
  FULFILLED
}

enum RecipeStatus {
  IDEA
  READY
  PUBLISHED
}

enum CropType {
  ANNUAL
  PERENNIAL
  BIENNIAL
}

enum IngredientSource {
  GARDEN    // Grown in the garden, linked to a Crop
  PANTRY    // Store-bought pantry staples (sugar, spices, etc.)
  PACKAGING // Jars, lids, labels, bags
}

// =====================================
// ORGANIZATION MANAGEMENT (Seeds of Kindness)
// =====================================

model Organization {
  id               String             @id @default(uuid())
  name             String
  shortDescription String             // For checkout dropdown
  description      String             // Fuller description for Impact page
  category         OrganizationCategory
  website          String?
  logoUrl          String?
  imageUrl         String?
  status           OrganizationStatus @default(IN_POOL)
  // Optional contact info (for admin reference)
  contactPerson    String?
  contactEmail     String?
  // Cycle tracking - which cycles this org was active in
  activeCycles     String[]           @default([])  // e.g., ["Fall 2025", "Spring 2026"]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([category])
  @@map("organizations")
}

model Nomination {
  id                 String           @id @default(uuid())
  organizationName   String
  website            String?
  missionDescription String           // What the org does
  reason             String           // Why nominator thinks they're a good fit
  nominatorName      String?
  nominatorEmail     String?
  status             NominationStatus @default(PENDING)
  // Review tracking
  reviewedBy         String?          // Admin email who reviewed
  reviewedAt         DateTime?
  reviewNotes        String?
  // If approved, link to created organization
  createdOrgId       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@map("nominations")
}

enum OrganizationCategory {
  FOOD
  GARDEN
  YOUTH
  COMMUNITY
}

enum OrganizationStatus {
  ACTIVE       // Currently available for customers to select
  IN_POOL      // Approved, not currently active
  PAST_PARTNER // Was active in previous cycles (can be reactivated)
}

enum NominationStatus {
  PENDING   // Awaiting review
  APPROVED  // Approved and added to pool
  REJECTED  // Not accepted
}
